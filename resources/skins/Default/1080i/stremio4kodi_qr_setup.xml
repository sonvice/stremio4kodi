<?xml version="1.0" encoding="utf-8"?>
<window type="dialog">
  <defaultcontrol always="true">100</defaultcontrol>
  <controls>
    <!-- Fondo oscuro oscurecido detrás del diálogo -->
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture>overlay.png</texture>
      <colordiffuse>F2000000</colordiffuse>
    </control>

    <!-- Tarjeta principal del diálogo -->
    <control type="image">
      <left>180</left>
      <top>90</top>
      <width>1560</width>
      <height>900</height>
      <texture>card_bg.png</texture>
      <border>16</border>
    </control>

    <!-- Icono nativo de red en la cabecera -->
    <control type="image">
      <left>240</left>
      <top>130</top>
      <width>64</width>
      <height>64</height>
      <aspectratio>keep</aspectratio>
      <texture>DefaultNetwork.png</texture>
    </control>

    <!-- Título principal -->
    <control type="label">
      <left>325</left>
      <top>130</top>
      <width>1300</width>
      <height>45</height>
      <font>font30_title</font>
      <textcolor>FF00E5FF</textcolor>
      <label>Configuración desde el Móvil</label>
    </control>

    <!-- Subtítulo -->
    <control type="label">
      <left>325</left>
      <top>178</top>
      <width>1300</width>
      <height>30</height>
      <font>font13</font>
      <textcolor>FF9AB3DB</textcolor>
      <label>Escanea el código QR con tu teléfono o accede a la URL en tu navegador</label>
    </control>

    <!-- Línea divisoria -->
    <control type="image">
      <left>240</left>
      <top>225</top>
      <width>1440</width>
      <height>2</height>
      <texture>btn_nofocus.png</texture>
    </control>

    <!-- Marco blanco para el Código QR -->
    <control type="image">
      <left>240</left>
      <top>255</top>
      <width>480</width>
      <height>480</height>
      <texture>qr_bg.png</texture>
    </control>

    <!-- Imagen del Código QR -->
    <control type="image" id="200">
      <left>260</left>
      <top>275</top>
      <width>440</width>
      <height>440</height>
      <aspectratio>keep</aspectratio>
      <texture>$INFO[Window.Property(stremio4kodi.qr)]</texture>
    </control>

    <!-- Estado en vivo debajo del QR -->
    <control type="label" id="203">
      <left>240</left>
      <top>755</top>
      <width>480</width>
      <height>40</height>
      <font>font13</font>
      <align>center</align>
      <textcolor>FFFFDD00</textcolor>
      <label>• Esperando conexión del móvil...</label>
    </control>

    <!-- Instrucciones paso a paso -->
    <control type="textbox">
      <left>760</left>
      <top>255</top>
      <width>920</width>
      <height>300</height>
      <font>font14</font>
      <textcolor>FFF0F4FC</textcolor>
      <label>[B][COLOR FF00E5FF]PASO 1[/COLOR][/B] — Conecta tu móvil a la [B]misma red Wi-Fi[/B] que este Kodi.[CR][CR][B][COLOR FF00E5FF]PASO 2[/COLOR][/B] — Abre la app de [B]cámara o lector QR[/B] del móvil y apunta al código.[CR][CR][B][COLOR FF00E5FF]PASO 3[/COLOR][/B] — Introduce tus cuentas (Real-Debrid, TorBox, TorrServer, Stremio o Torznab) y pulsa [B]Guardar en Kodi[/B].[CR][CR][COLOR FF9AB3DB]Esta pantalla se cerrará automáticamente al guardar los ajustes.[/COLOR]</label>
    </control>

    <!-- Etiqueta de URL alternativa -->
    <control type="label">
      <left>760</left>
      <top>575</top>
      <width>920</width>
      <height>30</height>
      <font>font12</font>
      <textcolor>FF9AB3DB</textcolor>
      <label>O escribe directamente esta dirección en el navegador de tu móvil o PC:</label>
    </control>

    <!-- Botón con la URL en texto interactivo -->
    <control type="button" id="101">
      <left>760</left>
      <top>615</top>
      <width>920</width>
      <height>60</height>
      <font>font14</font>
      <align>left</align>
      <textoffsetx>25</textoffsetx>
      <texturefocus>btn_focus.png</texturefocus>
      <texturenofocus>btn_nofocus.png</texturenofocus>
      <textcolor>FF00E5FF</textcolor>
      <focusedcolor>FF000000</focusedcolor>
      <label>$INFO[Window.Property(stremio4kodi.url)]</label>
      <onup>100</onup>
      <ondown>100</ondown>
      <onleft>100</onleft>
      <onright>100</onright>
    </control>

    <!-- Botón Cerrar / Cancelar -->
    <control type="button" id="100">
      <left>1380</left>
      <top>870</top>
      <width>300</width>
      <height>65</height>
      <font>font14</font>
      <align>center</align>
      <texturefocus>btn_focus.png</texturefocus>
      <texturenofocus>btn_nofocus.png</texturenofocus>
      <textcolor>FFFFFFFF</textcolor>
      <focusedcolor>FF000000</focusedcolor>
      <label>Cerrar / Cancelar</label>
      <onup>101</onup>
      <ondown>101</ondown>
      <onleft>101</onleft>
      <onright>101</onright>
    </control>
  </controls>
</window>
